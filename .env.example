# Postgres credentials (consumed by both worker and the postgres container)
POSTGRES_USER=veo
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=veo_audit
POSTGRES_HOST=denver_spatial_db
POSTGRES_PORT=5432

# Cloudflare R2 — 48-hour Parquet archive destination
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=veo-audit-archive

# Sentry — leave blank to disable
SENTRY_DSN=

# Admin panel — GitHub OAuth (acts as the OIDC provider)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_ALLOWED_GITHUB_ORGS=
SESSION_SECRET=change_me_to_random_64_chars
# Set to "false" only when running locally over plain HTTP; default true (prod is HTTPS via Cloudflare Tunnel)
SESSION_HTTPS_ONLY=true

# Cloudflare Tunnel — token from the Zero Trust dashboard
# Routes data.scooter.fyi -> pipeline_worker:8080
CLOUDFLARE_TUNNEL_TOKEN=

# CI/CD — used by GitHub Actions, not the worker itself
# VPS_SSH_KEY (multiline)
# VPS_HOST=
# VPS_USER=
