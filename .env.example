# Postgres credentials (consumed by both worker and the postgres container)
POSTGRES_USER=veo
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=veo_audit
POSTGRES_HOST=denver_spatial_db
POSTGRES_PORT=5432

# Cloudflare R2 — 48-hour Parquet archive destination
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=veo-audit-archive
# Private bucket for discount-report receipt images (API_REQUIREMENTS.md §3.2).
# Same R2 credentials; separate bucket so the archive bucket can stay
# public-readable without ever exposing receipts.
R2_RECEIPTS_BUCKET=scooter-fyi-receipts
# Routing assets published by denver-map-prep: denver_scooter_custom.pbf (the
# Valhalla graph input) and denver_canopy_coverage.csv.gz (way_id -> tree canopy
# fraction, used to score the `shade` routing profile). Same account
# credentials; the bucket stays private because the fetch sidecar reads it with
# SigV4 rather than Valhalla's unsigned tile_urls download.
R2_MAP_BUCKET=denver-street-optimized-data
# The Photon geocoding index (photon/photon-index-<YYYYMMDD>.tar.zst, fetched by
# `src.cli fetch_photon_index` for the photon sidecar) lives in THIS bucket
# under the same scoped token — deliberately no new env var for it, since it is
# the same private bucket read the same way. See scripts/build_photon_index.md.
# A DEDICATED read token is required: the archive token above is scoped to
# veo-audit's own buckets and returns 401 on denver-street-optimized-data.
# Mint one with "Object Read" on that bucket; the S3 access key id is the token
# id and the secret is SHA-256 of the token value (same derivation
# denver-map-prep documents in its own .env).
R2_MAP_ACCESS_KEY_ID=
R2_MAP_SECRET_ACCESS_KEY=

# Sentry — leave blank to disable
SENTRY_DSN=

# Accounts & sessions (API_REQUIREMENTS.md §2) --------------------------------
# Google Identity Services OAuth client id — POST /api/v1/auth/google verifies
# ID tokens against this audience. Blank = google sign-in returns 503.
GOOGLE_OAUTH_CLIENT_ID=
# Master switch for the Google sign-in door. Default ON. Set to a falsy value
# (false/0/no/off) to force Google OFF regardless of GOOGLE_OAUTH_CLIENT_ID —
# /auth/google then 503s and /auth/config reports google_enabled=false. Email
# sign-in (magic link + code) is unaffected. Currently OFF while email
# sign-in is the only offered door.
GOOGLE_AUTH_ENABLED=false
# DEPRECATED / NO LONGER READ. The admin allowlist now lives in Postgres
# (admin_allowlist table, sql/021), managed from the GitHub-gated admin
# portal at /admin/admins or `python -m src.cli admin add <email>`. Left
# here only so old deploy env doesn't error; the value is ignored.
# ADMIN_EMAILS=
# Postmark transactional account — magic-link email delivery. Blank = magic-link
# sign-in returns 503. POSTMARK_FROM must be a verified sender signature.
POSTMARK_TOKEN=
POSTMARK_FROM=
# Where the emailed sign-in link points; {token} is substituted.
MAGIC_LINK_URL_TEMPLATE=https://denver.scooter.fyi/auth?ml={token}

# z280-comms — outbound SMS (sign-in codes) and inbound reply collection.
# See z280/comms:docs/INTEGRATION.md. Blank COMMS_TOKEN = SMS sign-in is off
# (the endpoints 503, /auth/config reports sms_enabled:false, and the reply
# poller no-ops) — a fully supported state, not a broken one.
#
# The token is issued per application by the operator and IS our identity:
# it decides which replies we receive. Never share it with another app.
#
# COMMS_BASE_URL is optional; blank uses the default below. It is reachable
# on the tailnet ONLY, so both the api and scheduler containers need a route
# to it — set the tailnet IP here if the name doesn't resolve in-container.
COMMS_TOKEN=
COMMS_BASE_URL=https://ovh3.kudu-squeaker.ts.net/comms


# Admin panel — GitHub OAuth (acts as the OIDC provider)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_ALLOWED_GITHUB_ORGS=
SESSION_SECRET=change_me_to_random_64_chars
# Set to "false" only when running locally over plain HTTP; default true (prod is HTTPS via Cloudflare Tunnel)
SESSION_HTTPS_ONLY=true

# Cloudflare Tunnel — token from the Zero Trust dashboard
# Routes data.scooter.fyi -> pipeline_worker:8080
CLOUDFLARE_TUNNEL_TOKEN=

# CI/CD — used by GitHub Actions, not the worker itself
# VPS_SSH_KEY (multiline)
# VPS_HOST=
# VPS_USER=
