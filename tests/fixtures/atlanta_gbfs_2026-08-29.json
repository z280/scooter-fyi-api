  "retrieved_at": "2026-08-29T11:48:26Z",
  "purpose": "Golden fixture for the GbfsAdapter (MULTI_TENANCY_PLAN.md \u00a77). Two live GBFS feeds at real coordinate distribution, carrying the divergences a spec-compliant baseline has to absorb: Bird's 0-1 float current_fuel_percent, Bird's float current_range_meters vs Lime's int, Lime's redundant vehicle_type string beside vehicle_type_id, and a vehicle_types registry that declares types with no vehicles in them. Vehicle arrays are a seeded random sample, NOT the full fleet -- see fleet_size for the real counts. Positions/batteries are one instant; nothing here is a time series.",
  "identity_probe": {
   "method": "free_bike_status polled 7 times over a 15-minute window (~150s apart), bike_id sets compared between consecutive snapshots, plus a control pair inside one Bird ttl=60 generation.",
   "bird": {
    "verdict": "NO stable identifier",
    "cross_generation_gap_seconds": 191,
    "ids_persisted": 0,
    "ids_at_t0": 2896,
    "ids_at_t1": 2897,
    "within_generation_control": "2899/2899 ids and 2899/2899 coordinates identical across an 8s pair sharing one last_updated",
    "reading": "ids are stable within a cached generation and re-minted on every ~60s regeneration. No cross-cycle identity and no partial signal to salvage. Honest failure -- the emptiness is visible immediately."
   },
   "lime": {
    "verdict": "NO usable stable identifier -- periodic GLOBAL re-mint",
    "steady_state_persistence": 0.993,
    "trip_survival": "CONFIRMED within an epoch: one id vanished and returned as the same id 913 m away with current_range_meters 3313->2767, i.e. a completed rental with the identifier preserved.",
    "global_remint": {
     "observed": true,
     "gap_seconds": 151,
     "ids_before": 2929,
     "ids_after": 2923,
     "ids_shared": 0,
     "coordinates_shared": 2830,
     "reading": "every id replaced at once while 2830/2929 coordinates stayed byte-identical -- same physical fleet, wholly new keys. Both id sets are well-formed UUIDv4; an epoch boundary is indistinguishable from outside except that every key changes simultaneously. One rotation seen in ~15 min, so the period is bounded above at roughly that and otherwise unpinned."
    },
    "why_worse_than_bird": "an adapter that trusts Lime's bike_id does not degrade gracefully at a boundary, it hallucinates: ~2900 phantom trip-ends and ~2900 phantom first-sightings per rotation, device_history fragmented into epoch shards, unbounded registry growth, and every per-device report/photo/QR binding orphaned. Bird's honest rotation yields an obviously empty feature; Lime's yields a plausible-looking wrong one."
   },
   "verdict": "BOTH operators are stable_vehicle_id: false"
